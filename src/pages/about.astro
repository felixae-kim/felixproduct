---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { existsSync } from 'node:fs';
import { SITE_TITLE } from '../consts';

const photo = ['profile.jpg', 'profile.jpeg', 'profile.png', 'profile.webp'].find((f) =>
	existsSync(`public/${f}`),
);

const principles = [
	{ en: 'Possibility', ko: '가능성', desc: '제품의 성공은 보장되지 않습니다. 감이 아니라 명확한 근거를 레버로 삼아 성공 확률을 높입니다.' },
	{ en: 'Simplicity', ko: '단순함', desc: '복잡함을 사용자에게 떠넘기지 않습니다. 어려운 문제일수록 가장 단순한 경험으로 풉니다.' },
	{ en: 'Absorbency', ko: '흡수력', desc: '도메인의 경계를 두지 않습니다. 낯선 문제는 모른다고 인정하고, 치열하게 배워 내 것으로 만듭니다.' },
];

const experience = [
	{ org: '레브잇 (Alwayz)', role: 'Commerce Product Lead', period: '2026.03 – 현재' },
	{ org: '부산 핀테크 허브', role: 'Lecturer', period: '2025.11 – 2026.02' },
	{ org: '무신사 (29CM)', role: 'Sr. Product Manager', period: '2025.07 – 2025.10' },
	{ org: '라인파이낸셜 (LINE BK)', role: 'Product Owner', period: '2024.11 – 2025.07' },
	{ org: '토스뱅크', role: 'Product Owner', period: '2023.05 – 2024.09' },
	{ org: '원티드랩', role: 'Product Owner', period: '2022.09 – 2023.05' },
	{ org: '버킷플레이스 (오늘의집)', role: 'Product Owner', period: '2021.07 – 2022.05' },
	{ org: '우아한형제들 (배달의민족)', role: 'Product Manager', period: '2020.05 – 2021.06' },
	{ org: 'SSG.COM', role: 'Service Planner', period: '2016.03 – 2020.05' },
];

const work = [
	{ org: '토스뱅크', desc: '서민금융 대출 햇살론뱅크를 만들어, 복잡한 심사를 스크래핑으로 자동화하고 가장 단순한 대출 경험으로 시장 점유율 1위를 만들었습니다.' },
	{ org: '토스뱅크', desc: '신형 신분증 인식 실패로 막히던 계좌개설을, 자체 OCR 모델과 수기 검수 프로세스를 결합해 빈틈없이 풀었습니다.' },
	{ org: '오늘의집', desc: '날짜를 확약할 수 없던 가구 배송을, 접수부터 설치까지 관리하는 지정일 배송 시스템(TMS)을 0에서 1로 구축해 예측 가능하게 만들었습니다.' },
	{ org: '배달의민족', desc: '라이더 배달지표와 인센티브를 설계해, 급증하는 배달 건에도 배달 품질을 지켰습니다.' },
	{ org: '원티드', desc: '통합검색을 만들어, 흩어져 있던 커리어 경험을 하나로 연결했습니다.' },
	{ org: '레브잇', desc: '메인홈 개편, 신선보장, 커머스 도메인 리팩토링 등 커머스 플랫폼 전반을 고도화하고 있습니다.' },
];

const lectures = [
	{
		group: '기업 · 기관',
		items: [
			{ org: '글로벌핀테크진흥센터 (FINPC)', course: '디지털금융 전문인력 양성과정' },
			{ org: '삼성금융연수원', course: '디지털 입문 과정: 디지털서비스 A to Z' },
			{ org: '삼성화재', course: '디지털 서비스 기획 과정' },
			{ org: 'KB금융', course: '디지털 서비스 기획 과정' },
			{ org: '삼성생명', course: '디자인씽킹 과정' },
			{ org: '하나금융TI', course: '디자인씽킹 과정' },
			{ org: 'CJ올리브네트웍스', course: 'AX 해커톤 디자인씽킹 과정' },
			{ org: '네이버클라우드', course: '프로덕트 리딩 역량 향상 과정' },
			{ org: '부산 핀테크 허브', course: '핀테크 스타트업 대표·PM 대상 제품 강의' },
		],
	},
	{
		group: '온라인',
		items: [
			{ org: '패스트캠퍼스', course: '한 번에 끝내는 서비스 기획의 모든 것 - O2O 서비스 기획' },
			{ org: '패스트캠퍼스', course: '메가바이트 스쿨 프로덕트 매니저 과정 (멘토링)' },
			{ org: 'SW Camp', course: '프로덕트 매니저 과정 (멘토링)' },
		],
	},
	{
		group: '대학',
		items: [
			{ org: '이화여자대학교', course: 'e커머스 서비스 기획 과정' },
			{ org: '전북대학교', course: '스타트업 디자인 스쿨' },
		],
	},
];
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`About · ${SITE_TITLE}`} description="김성재 · 프로덕트 리드. 커머스, 핀테크, 물류 플랫폼에서 고객 문제를 풀어온 11년차 제품 담당자." />
	</head>
	<body>
		<Header />
		<main>
			<div class="about-head">
				{
					photo ? (
						<img class="avatar" src={`/${photo}`} alt="Seongjae Kim" width="120" height="120" />
					) : (
						<div class="avatar ph" aria-hidden="true">SK</div>
					)
				}
				<div class="about-intro">
					<div class="term"><span class="p">$</span> cat about.md</div>
					<h1>About</h1>
					<p class="lead">
						제품을 만드는 사람입니다. 무엇을 왜 만들지 정의해서, 디자이너와 개발자가 정말 임팩트 있는
						일에만 집중하게 만드는 것이 제 일입니다. 커머스, 핀테크, 물류 같은 플랫폼 비즈니스에서 11년.
						많은 곳을 거쳤지만 목표는 늘 같았습니다. 사용자와 임팩트. 경쟁자와 똑같은 서비스여도 고객에게
						몰입하면 답이 나온다고 믿었고, 그렇게 시장 1위 제품도, 0에서 1을 만드는 일도 해냈습니다.
					</p>
				</div>
			</div>
			<blockquote class="epigraph">
				"Only the market can tell if your idea is good. Everything else is just opinion."
			</blockquote>

			<section class="block">
				<p class="comment">// now</p>
				<p>
					레브잇(올웨이즈)에서 Commerce, CS&Seller, Search&Recommend 세 스쿼드(약 15명)를
					리드합니다. 커머스 전반의 문제를 정의하고 제품 방향을 설계하며, 각 스쿼드의 성장을
					돕습니다.
				</p>
			</section>

			<section class="block">
				<p class="comment">// how i work</p>
				<ul class="principles">
					{
						principles.map((pr) => (
							<li>
								<span class="pt">
									{pr.en} <span class="pk">{pr.ko}</span>
								</span>
								<span class="pd">{pr.desc}</span>
							</li>
						))
					}
				</ul>
			</section>

			<section class="block">
				<p class="comment">// experience</p>
				<ul class="rows">
					{
						experience.map((e) => (
							<li>
								<span class="org">{e.org}</span>
								<span class="role">{e.role}</span>
								<span class="period">{e.period}</span>
							</li>
						))
					}
				</ul>
			</section>

			<section class="block">
				<p class="comment">// selected work</p>
				<ul class="work">
					{
						work.map((w) => (
							<li>
								<span class="wo">{w.org}</span>
								<span class="wd">{w.desc}</span>
							</li>
						))
					}
				</ul>
			</section>

			<section class="block">
				<p class="comment">// lectures</p>
				{
					lectures.map((lg) => (
						<div class="lgroup">
							<p class="llabel">{lg.group}</p>
							<ul class="lec">
								{lg.items.map((it) => (
									<li>
										<span class="lorg">{it.org}</span>
										<span class="lcourse">{it.course}</span>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</section>

			<section class="block">
				<p class="comment">// background</p>
				<ul class="dolist">
					<li>경희대학교 경영학·역사학(복수전공)</li>
					<li>영어 비즈니스 레벨. 태국 자회사와 영어로 협업했습니다.</li>
					<li>자주 쓰는 도구: Claude, Claude Code, Databricks, Amplitude, SQL</li>
					<li>WSET Level 3. 와인을 좋아해서 자격증까지 땄습니다.</li>
				</ul>
			</section>

			<section class="block">
				<p class="comment">// contact</p>
				<ul class="links">
					<li><span class="k">email</span> <a href="mailto:hzory74@gmail.com">hzory74@gmail.com</a></li>
					<li><span class="k">linkedin</span> <a href="https://www.linkedin.com/in/seongjae-kim-747b35151/" target="_blank" rel="me">linkedin.com/in/seongjae-kim</a></li>
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.term {
		font-family: var(--font-mono);
		font-size: 0.9rem;
		color: var(--muted);
		margin-bottom: 0.6rem;
	}
	.term .p {
		color: var(--green);
	}
	.about-head {
		display: flex;
		align-items: flex-start;
		gap: 1.6rem;
		margin-bottom: 1.4rem;
	}
	.about-head .avatar {
		flex: 0 0 auto;
		width: 120px;
		height: 120px;
		border-radius: 50%;
		border: 1px solid var(--border-strong);
		margin-top: 0.3rem;
	}
	.about-head img.avatar {
		object-fit: cover;
	}
	.about-head .ph {
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--surface);
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 1.8rem;
	}
	.about-intro {
		flex: 1 1 auto;
		min-width: 0;
	}
	h1 {
		margin-bottom: 1.2rem;
	}
	.lead {
		color: var(--fg);
		max-width: 46ch;
	}
	.epigraph {
		border-left: 3px solid var(--accent);
		padding: 0.1rem 0 0.1rem 1rem;
		margin: 1.4rem 0 0;
		font-family: var(--font-mono);
		font-size: 0.9rem;
		color: var(--muted);
		line-height: 1.6;
	}
	.block {
		margin-top: 2.6rem;
	}
	.comment {
		font-family: var(--font-mono);
		color: var(--muted);
		font-size: 0.85rem;
		margin: 0 0 0.9rem;
	}

	/* principles */
	.principles {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.principles li {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: 0.6rem 0;
		border-bottom: 1px solid var(--border);
		margin: 0;
	}
	.principles li:last-child {
		border-bottom: none;
	}
	.pt {
		font-family: var(--font-mono);
		font-weight: 600;
		color: var(--fg-strong);
		font-size: 0.95rem;
	}
	.pk {
		color: var(--green);
		font-size: 0.85rem;
	}
	.pd {
		color: var(--fg);
	}

	/* experience */
	.rows {
		list-style: none;
		padding: 0;
		margin: 0;
		font-family: var(--font-mono);
		border-top: 1px solid var(--border);
	}
	.rows li {
		display: flex;
		align-items: baseline;
		gap: 0.9rem;
		padding: 0.7rem 0.2rem;
		border-bottom: 1px solid var(--border);
		margin: 0;
	}
	.rows .org {
		flex: 0 0 auto;
		color: var(--fg-strong);
		font-size: 0.9rem;
	}
	.rows .role {
		flex: 1 1 auto;
		color: var(--muted);
		font-size: 0.82rem;
	}
	.rows .period {
		flex: 0 0 auto;
		color: var(--muted);
		font-size: 0.78rem;
		white-space: nowrap;
	}

	/* selected work */
	.work {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.work li {
		display: flex;
		gap: 0.9rem;
		padding: 0.55rem 0;
		margin: 0;
	}
	.work .wo {
		flex: 0 0 5.5rem;
		font-family: var(--font-mono);
		font-size: 0.82rem;
		color: var(--green);
		padding-top: 0.15rem;
	}
	.work .wd {
		flex: 1 1 auto;
		color: var(--fg);
	}

	/* lectures */
	.lgroup {
		margin-bottom: 1.4rem;
	}
	.llabel {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--green);
		margin: 0 0 0.4rem;
	}
	.lec {
		list-style: none;
		padding: 0;
		margin: 0;
		border-top: 1px solid var(--border);
	}
	.lec li {
		display: flex;
		align-items: baseline;
		gap: 0.9rem;
		padding: 0.5rem 0.2rem;
		border-bottom: 1px solid var(--border);
		margin: 0;
	}
	.lec .lorg {
		flex: 0 0 auto;
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--fg-strong);
	}
	.lec .lcourse {
		flex: 1 1 auto;
		color: var(--muted);
		font-size: 0.9rem;
	}

	/* background + contact */
	.dolist {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.dolist li {
		position: relative;
		padding-left: 1.3rem;
		margin: 0 0 0.5rem;
		color: var(--fg);
	}
	.dolist li::before {
		content: '▸';
		position: absolute;
		left: 0;
		color: var(--green);
	}
	.links {
		list-style: none;
		padding: 0;
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.9rem;
	}
	.links li {
		display: flex;
		gap: 0.8rem;
		padding: 0.3rem 0;
		margin: 0;
	}
	.links .k {
		color: var(--muted);
		min-width: 5.5rem;
	}
	.links a {
		color: var(--accent);
	}

	@media (max-width: 600px) {
		.about-head {
			flex-direction: column;
			gap: 1rem;
		}
		.rows li,
		.lec li {
			flex-wrap: wrap;
			gap: 0.2rem 0.8rem;
		}
		.rows .org {
			flex: 1 1 100%;
			order: 1;
		}
		.rows .role {
			order: 2;
		}
		.rows .period {
			order: 2;
			margin-left: auto;
		}
		.lec .lorg {
			flex: 1 1 100%;
		}
		.work li {
			flex-direction: column;
			gap: 0.2rem;
		}
		.work .wo {
			flex: 0 0 auto;
		}
	}
</style>
