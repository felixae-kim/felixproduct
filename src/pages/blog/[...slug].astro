---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	// Sorted by id so the series order (00…09) drives prev/next.
	const posts = (await getCollection('blog')).sort((a, b) => a.id.localeCompare(b.id));
	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: {
			...post,
			index: i,
			total: posts.length,
			prev: posts[i - 1] && { id: posts[i - 1].id, title: posts[i - 1].data.title },
			next: posts[i + 1] && { id: posts[i + 1].id, title: posts[i + 1].data.title },
		},
	}));
}
type Props = CollectionEntry<'blog'> & {
	index: number;
	total: number;
	prev?: { id: string; title: string };
	next?: { id: string; title: string };
};

const { index, total, prev, next, ...post } = Astro.props;
const { Content } = await render(post as CollectionEntry<'blog'>);
---

<BlogPost {...post.data} {index} {total} {prev} {next}>
	<Content />
</BlogPost>
