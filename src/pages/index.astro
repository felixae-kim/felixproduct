---
import { existsSync } from 'node:fs';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const recent = posts.slice(0, 5);
const total = posts.length;

// Use a photo from /public if present, otherwise fall back to initials.
const photo = ['profile.jpg', 'profile.jpeg', 'profile.png', 'profile.webp'].find((f) =>
	existsSync(`public/${f}`),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				{
					photo ? (
						<img class="avatar" src={`/${photo}`} alt="Seongjae Kim" width="112" height="112" />
					) : (
						<div class="avatar ph" aria-hidden="true">SK</div>
					)
				}
				<div class="intro">
					<div class="term">
						<span class="p">$</span> whoami <span class="arrow">→</span> Seongjae Kim · product owner
					</div>
					<h1>안녕하세요, 김성재입니다.</h1>
					<p class="lead">
						제품을 만드는 사람입니다. 무엇을 왜 만들지 정의해서, 디자이너와 개발자가 정말 임팩트
						있는 일에 집중하도록 돕습니다. 커머스와 핀테크, 물류 플랫폼에서 11년째 고객의 문제를
						풀어왔고, 이곳에는 디자인 씽킹과 문제에서 시작하는 법을 씁니다.
					</p>
					<p class="more">
						<a href="/about">→ 더 알아보기</a>
						<span class="sep">·</span>
						<a href="https://www.linkedin.com/in/seongjae-kim-747b35151/" target="_blank" rel="me">linkedin</a>
					</p>
				</div>
			</section>

			<section class="block">
				<div class="head">
					<p class="comment">// recent writing</p>
					<a class="all" href="/blog">→ all writing ({total})</a>
				</div>
				<ul class="posts">
					{
						recent.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<span class="no">[{post.id.slice(0, 2)}]</span>
									<span class="t">{post.data.title}</span>
									<span class="date">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		display: flex;
		align-items: center;
		gap: 1.8rem;
		padding: 1.5rem 0 2.5rem;
		border-bottom: 1px solid var(--border);
		margin-bottom: 2.5rem;
	}
	.avatar {
		flex: 0 0 auto;
		width: 112px;
		height: 112px;
		border-radius: 50%;
		border: 1px solid var(--border-strong);
	}
	img.avatar {
		object-fit: cover;
	}
	.ph {
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--surface);
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 1.7rem;
		letter-spacing: 0.05em;
	}
	.intro {
		flex: 1 1 auto;
		min-width: 0;
	}
	.term {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--muted);
		margin-bottom: 0.7rem;
	}
	.term .p {
		color: var(--green);
	}
	.term .arrow {
		color: var(--muted);
	}
	.hero h1 {
		font-size: 1.9rem;
		line-height: 1.25;
		margin: 0 0 0.8rem;
		color: var(--fg-strong);
	}
	.lead {
		color: var(--fg);
		margin: 0 0 1rem;
		font-size: 1.02rem;
	}
	.more {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		margin: 0;
	}
	.more a {
		color: var(--accent);
		text-decoration: none;
	}
	.more a:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.more .sep {
		color: var(--muted);
		margin: 0 0.5rem;
	}

	.block {
		margin-bottom: 2.75rem;
	}
	.block .head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}
	.comment {
		font-family: var(--font-mono);
		color: var(--muted);
		font-size: 0.85rem;
		margin: 0 0 0.9rem;
	}
	.all {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		color: var(--accent);
		text-decoration: none;
	}
	.all:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.posts {
		list-style: none;
		padding: 0;
		margin: 0;
		font-family: var(--font-mono);
		border-top: 1px solid var(--border);
	}
	.posts li {
		margin: 0;
		border-bottom: 1px solid var(--border);
	}
	.posts a {
		display: flex;
		align-items: baseline;
		gap: 0.9rem;
		padding: 0.7rem 0.2rem;
		text-decoration: none;
	}
	.posts a:hover {
		text-decoration: none;
	}
	.posts .no {
		flex: 0 0 auto;
		color: var(--green);
		font-size: 0.9rem;
	}
	.posts .t {
		flex: 1 1 auto;
		color: var(--fg-strong);
		font-size: 0.95rem;
	}
	.posts a:hover .t {
		color: var(--accent);
	}
	.posts .date {
		flex: 0 0 auto;
		font-size: 0.78rem;
		color: var(--muted);
		white-space: nowrap;
	}

	@media (max-width: 640px) {
		.hero {
			flex-direction: column;
			align-items: flex-start;
			gap: 1.1rem;
		}
		.hero h1 {
			font-size: 1.7rem;
		}
		.posts a {
			flex-wrap: wrap;
			gap: 0.3rem 0.6rem;
		}
		.posts .t {
			flex: 1 1 100%;
			order: 3;
			padding-left: 2.1rem;
		}
		.posts .no {
			order: 1;
		}
		.posts .date {
			order: 2;
			margin-left: auto;
		}
	}
</style>
