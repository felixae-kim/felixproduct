---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = await getCollection('blog');
const published = new Set(posts.map((p) => p.id));

const series = [
	{ no: 0, title: 'Start from the problem, not the solution', slug: '00-start-from-problem' },
	{ no: 1, title: 'Why design thinking, now', slug: '01-why-design-thinking' },
	{ no: 2, title: 'Defining who your customer is', slug: '02-defining-the-customer' },
	{ no: 3, title: 'Seeing the problem through data', slug: '03-problem-through-data' },
	{ no: 4, title: 'Customers lie: surveys, interviews, observation', slug: '04-customers-lie' },
	{ no: 5, title: 'Symptoms vs root cause', slug: '05-root-cause' },
	{ no: 6, title: "Don't build everything: two axes for picking problems", slug: '06-pick-problems' },
	{ no: 7, title: 'Good solutions come from analysis', slug: '07-solutions-from-analysis' },
	{ no: 8, title: 'Winning like a casino: hypotheses and metrics', slug: '08-hypotheses-and-metrics' },
	{ no: 9, title: 'Start from the job your product is hired for', slug: '09-jobs-to-be-done' },
].map((e) => ({ ...e, live: published.has(e.slug) }));

const startSlug = '00-start-from-problem';
const pad = (n: number) => String(n).padStart(2, '0');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="term">
					<span class="line"><span class="p">$</span> whoami</span>
					<span class="line out">product owner · design thinking</span>
				</div>
				<h1>Start from the problem, <br />not the solution.</h1>
				<p class="lead">
					A writing series for product people. Not about having good ideas, but about picking and
					defining the right problem to solve. One case runs through the whole series, from
					defining the customer to shaping the solution.
				</p>
				<div class="cta-row">
					<a class="cta" href={`/blog/${startSlug}/`}>[ start reading ]</a>
					<a class="cta ghost" href="/blog">[ all writing ]</a>
				</div>
			</section>

			<section class="block">
				<p class="comment">// what you'll take away</p>
				<ul class="takeaway">
					<li>Define problems <strong>with data</strong> so the whole team aligns.</li>
					<li>Dig to the <strong>root cause</strong> instead of the symptom.</li>
					<li>Learn to <strong>choose what not to build</strong>.</li>
					<li>Build hypotheses and metrics on <strong>cause and effect</strong>.</li>
				</ul>
			</section>

			<section class="block">
				<p class="comment">// the series</p>
				<ol class="series">
					{
						series.map((ep) => (
							<li class={ep.live ? 'live' : 'soon'}>
								<span class="no">[{pad(ep.no)}]</span>
								{ep.live ? (
									<a class="t" href={`/blog/${ep.slug}/`}>
										{ep.title}
									</a>
								) : (
									<span class="t">{ep.title}</span>
								)}
								<span class="dots" aria-hidden="true"></span>
								<span class="st">{ep.live ? 'live' : 'soon'}</span>
							</li>
						))
					}
				</ol>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		padding: 1.5rem 0 2.75rem;
		border-bottom: 1px solid var(--border);
		margin-bottom: 2.5rem;
	}
	.term {
		font-family: var(--font-mono);
		font-size: 0.9rem;
		margin-bottom: 1.4rem;
		color: var(--muted);
	}
	.term .line {
		display: block;
	}
	.term .p {
		color: var(--green);
	}
	.term .out {
		color: var(--fg);
	}
	.term .out::before {
		content: '→ ';
		color: var(--muted);
	}
	.hero h1 {
		font-size: 2.4rem;
		line-height: 1.2;
		margin: 0 0 1.1rem;
		color: var(--fg-strong);
	}
	.lead {
		font-family: var(--font-sans);
		color: var(--fg);
		max-width: 40ch;
		margin: 0 0 1.6rem;
	}
	.cta-row {
		display: flex;
		gap: 0.6rem;
		flex-wrap: wrap;
		font-family: var(--font-mono);
	}
	.cta {
		display: inline-block;
		padding: 0.55em 1em;
		border: 1px solid var(--accent);
		color: var(--accent);
		border-radius: 8px;
		text-decoration: none;
		font-size: 0.9rem;
	}
	.cta:hover {
		background: rgba(88, 166, 255, 0.12);
		text-decoration: none;
	}
	.cta.ghost {
		border-color: var(--border-strong);
		color: var(--muted);
	}
	.cta.ghost:hover {
		color: var(--fg-strong);
		background: var(--surface);
	}

	.block {
		margin-bottom: 2.75rem;
	}
	.comment {
		font-family: var(--font-mono);
		color: var(--muted);
		font-size: 0.85rem;
		margin: 0 0 0.9rem;
	}

	.takeaway {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.6rem 1.6rem;
	}
	.takeaway li {
		position: relative;
		padding-left: 1.3rem;
		color: var(--fg);
		font-size: 0.98rem;
		margin: 0;
	}
	.takeaway li::before {
		content: '▸';
		position: absolute;
		left: 0;
		color: var(--green);
	}

	.series {
		list-style: none;
		padding: 0;
		margin: 0;
		font-family: var(--font-mono);
		border-top: 1px solid var(--border);
	}
	.series li {
		display: flex;
		align-items: baseline;
		gap: 0.7rem;
		padding: 0.7rem 0.2rem;
		border-bottom: 1px solid var(--border);
		margin: 0;
	}
	.series .no {
		flex: 0 0 auto;
		color: var(--green);
		font-size: 0.9rem;
	}
	.series .t {
		flex: 0 1 auto;
		color: var(--fg-strong);
		text-decoration: none;
		font-size: 0.95rem;
	}
	.series a.t:hover {
		color: var(--accent);
		text-decoration: none;
	}
	.series .dots {
		flex: 1 1 auto;
		border-bottom: 1px dotted var(--border-strong);
		transform: translateY(-0.25em);
		min-width: 1rem;
	}
	.series .st {
		flex: 0 0 auto;
		font-size: 0.78rem;
		letter-spacing: 0.02em;
	}
	.series li.live .st {
		color: var(--green);
	}
	.series li.soon {
		opacity: 0.55;
	}
	.series li.soon .st {
		color: var(--muted);
	}

	@media (max-width: 640px) {
		.hero h1 {
			font-size: 1.95rem;
		}
		.hero h1 br {
			display: none;
		}
		.takeaway {
			grid-template-columns: 1fr;
		}
		.cta {
			flex: 1 1 auto;
			text-align: center;
		}
		.series .dots {
			display: none;
		}
		.series li {
			flex-wrap: wrap;
			gap: 0.4rem;
		}
		.series .t {
			flex: 1 1 100%;
			order: 2;
			padding-left: 2.1rem;
		}
		.series .no {
			order: 1;
		}
		.series .st {
			order: 1;
			margin-left: auto;
		}
	}
</style>
