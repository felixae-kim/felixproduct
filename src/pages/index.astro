---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostList from '../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { CATEGORIES, CATEGORY_KEYS, getFeatured, getPosts } from '../lib/posts';

const featured = (await getFeatured()).slice(0, 3);
const latest = (await getPosts()).slice(0, 5);
const sections = await Promise.all(
	CATEGORY_KEYS.map(async (key) => ({
		key,
		...CATEGORIES[key],
		posts: await getPosts(key),
	})),
);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="term">
					<span class="p">$</span> whoami <span class="arrow">→</span> product owner · 커머스 · 핀테크
					· 물류 · 11년
				</p>
				<h1>
					11년차 진지충 Product Guy는<br />
					세상에 어떤 임팩트를 남길 것인가
				</h1>
				<p class="lead">
					우리는 모두 '나'라는 1인칭 시점으로 살아갑니다. 우리는 왜 우리로 태어났을까요. 그것을
					증명하기 위해서 오늘도 어떤 임팩트를 남길 수 있을까 고민하며 살아갑니다.
				</p>
				<p class="more">
					<a href="/about">→ 더 알아보기</a>
					<span class="sep">·</span>
					<a href="https://www.linkedin.com/in/seongjae-kim-747b35151/" target="_blank" rel="me"
						>linkedin</a
					>
				</p>
			</section>

			{
				featured.length > 0 && (
					<section class="block">
						<div class="head">
							<p class="comment">// start here</p>
						</div>
						<PostList posts={featured} showCategory />
					</section>
				)
			}

			{
				latest.length > 0 && (
					<section class="block">
						<div class="head">
							<p class="comment">// latest</p>
						</div>
						<PostList posts={latest} showCategory />
					</section>
				)
			}

			{
				sections.map((s) => (
					<section class="block">
						<div class="head">
							<p class="comment">// {s.key}</p>
							{s.posts.length > 0 && (
								<a class="all" href={`/${s.key}`}>
									→ all ({s.posts.length})
								</a>
							)}
						</div>
						{s.posts.length > 0 ? (
							<PostList posts={s.posts.slice(0, 3)} />
						) : (
							<p class="empty">{s.blurb} 곧 시작합니다.</p>
						)}
					</section>
				))
			}

			<section class="strip">
				<div>
					<p class="label">NOW</p>
					<p>Product owner</p>
				</div>
				<div>
					<p class="label">CHANNELS</p>
					<p>
						<a href="https://www.linkedin.com/in/seongjae-kim-747b35151/" target="_blank" rel="me"
							>LinkedIn</a
						>
						<span class="sep">·</span>
						<a href="/rss.xml">RSS</a>
					</p>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		padding: 2.5rem 0 3rem;
		border-bottom: 1px solid var(--border);
		margin-bottom: 3rem;
	}
	.term {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--muted);
		margin: 0 0 1.4rem;
	}
	.term .p {
		color: var(--green);
	}
	.hero h1 {
		font-size: 2.3rem;
		line-height: 1.35;
		margin: 0 0 1.4rem;
		color: var(--fg-strong);
		letter-spacing: -0.02em;
	}
	.lead {
		color: var(--muted);
		margin: 0 0 1.4rem;
		font-size: 1rem;
		max-width: 34em;
	}
	.more {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		margin: 0;
	}
	.more .sep,
	.strip .sep {
		color: var(--muted);
		margin: 0 0.5rem;
	}

	.block {
		margin-bottom: 3rem;
	}
	.block .head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}
	.comment {
		font-family: var(--font-mono);
		color: var(--muted);
		font-size: 0.85rem;
		margin: 0 0 0.9rem;
	}
	.all {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		white-space: nowrap;
	}
	.empty {
		color: var(--muted);
		font-size: 0.92rem;
		margin: 0;
		padding: 1.1rem 0;
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
	}

	.strip {
		display: flex;
		flex-wrap: wrap;
		gap: 2.5rem;
		padding-top: 2rem;
		border-top: 1px solid var(--border);
		font-size: 0.9rem;
	}
	.strip .label {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		color: var(--muted);
		margin: 0 0 0.4rem;
	}
	.strip p {
		margin: 0;
	}

	@media (max-width: 640px) {
		.hero h1 {
			font-size: 1.75rem;
		}
	}
</style>
