---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const recent = posts.slice(0, 5);
const total = posts.length;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="term">
					<span class="line"><span class="p">$</span> whoami</span>
					<span class="line out">Seongjae Kim · product owner</span>
				</div>
				<h1>I build products,<br />and write about it.</h1>
				<p class="lead">
					제품을 만드는 사람입니다. 무엇을 왜 만들지 정의해서, 디자이너와 개발자가 정말 임팩트
					있는 일에 집중하도록 돕습니다. 이곳에는 디자인 씽킹과 문제에서 시작하는 법을 씁니다.
				</p>
			</section>

			<section class="block">
				<p class="comment">// elsewhere</p>
				<ul class="links">
					<li><span class="k">github</span> <a href="https://github.com/felixae-kim" target="_blank" rel="me">github.com/felixae-kim</a></li>
					<li><span class="k">linkedin</span> <a href="https://www.linkedin.com/in/seongjae-kim-747b35151/" target="_blank" rel="me">linkedin.com/in/seongjae-kim</a></li>
				</ul>
			</section>

			<section class="block">
				<div class="head">
					<p class="comment">// recent writing</p>
					<a class="all" href="/blog">→ all writing ({total})</a>
				</div>
				<ul class="posts">
					{
						recent.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<span class="no">[{post.id.slice(0, 2)}]</span>
									<span class="t">{post.data.title}</span>
									<span class="date">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		padding: 1.5rem 0 2.5rem;
		border-bottom: 1px solid var(--border);
		margin-bottom: 2.5rem;
	}
	.term {
		font-family: var(--font-mono);
		font-size: 0.9rem;
		margin-bottom: 1.4rem;
		color: var(--muted);
	}
	.term .line {
		display: block;
	}
	.term .p {
		color: var(--green);
	}
	.term .out::before {
		content: '→ ';
		color: var(--muted);
	}
	.term .out {
		color: var(--fg);
	}
	.hero h1 {
		font-size: 2.4rem;
		line-height: 1.2;
		margin: 0 0 1.1rem;
		color: var(--fg-strong);
	}
	.lead {
		font-family: var(--font-sans);
		color: var(--fg);
		max-width: 42ch;
		margin: 0;
	}

	.block {
		margin-bottom: 2.75rem;
	}
	.block .head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}
	.comment {
		font-family: var(--font-mono);
		color: var(--muted);
		font-size: 0.85rem;
		margin: 0 0 0.9rem;
	}
	.all {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		color: var(--accent);
		text-decoration: none;
	}
	.all:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.links {
		list-style: none;
		padding: 0;
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.9rem;
	}
	.links li {
		display: flex;
		gap: 0.8rem;
		padding: 0.3rem 0;
		margin: 0;
	}
	.links .k {
		color: var(--muted);
		min-width: 5.5rem;
	}
	.links a {
		color: var(--accent);
		text-decoration: none;
	}
	.links a:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.posts {
		list-style: none;
		padding: 0;
		margin: 0;
		font-family: var(--font-mono);
		border-top: 1px solid var(--border);
	}
	.posts li {
		margin: 0;
		border-bottom: 1px solid var(--border);
	}
	.posts a {
		display: flex;
		align-items: baseline;
		gap: 0.9rem;
		padding: 0.7rem 0.2rem;
		text-decoration: none;
	}
	.posts a:hover {
		text-decoration: none;
	}
	.posts .no {
		flex: 0 0 auto;
		color: var(--green);
		font-size: 0.9rem;
	}
	.posts .t {
		flex: 1 1 auto;
		color: var(--fg-strong);
		font-size: 0.95rem;
	}
	.posts a:hover .t {
		color: var(--accent);
	}
	.posts .date {
		flex: 0 0 auto;
		font-size: 0.78rem;
		color: var(--muted);
		white-space: nowrap;
	}

	@media (max-width: 640px) {
		.hero h1 {
			font-size: 1.95rem;
		}
		.hero h1 br {
			display: none;
		}
		.posts a {
			flex-wrap: wrap;
			gap: 0.3rem 0.6rem;
		}
		.posts .t {
			flex: 1 1 100%;
			order: 3;
			padding-left: 2.1rem;
		}
		.posts .no {
			order: 1;
		}
		.posts .date {
			order: 2;
			margin-left: auto;
		}
		.links .k {
			min-width: 4.5rem;
		}
	}
</style>
