---
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import PostToc from '../components/PostToc.astro';
import SeriesToc from '../components/SeriesToc.astro';
import { CATEGORIES, href, type Post } from '../lib/posts';

type Props = CollectionEntry<'posts'>['data'] & {
	id: string;
	prev?: Post;
	next?: Post;
	seriesPosts?: Post[];
	headings: MarkdownHeading[];
};

const {
	id,
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	category,
	series,
	prev,
	next,
	seriesPosts,
	headings,
} = Astro.props;
---

<html lang="ko">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main>
			<article>
				{
					heroImage && (
						<div class="hero-image">
							<Image width={1020} height={510} src={heroImage} alt="" />
						</div>
					)
				}
				<header class="title">
					<p class="meta">
						<a class="cat" href={`/${category}`}>{CATEGORIES[category].heading}</a>
						<span class="sep">·</span>
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<>
									<span class="sep">·</span>
									<span class="updated">
										updated <FormattedDate date={updatedDate} />
									</span>
								</>
							)
						}
					</p>
					{
						series && (
							<p class="series">{series}</p>
						)
					}
					<h1>{title}</h1>
					<p class="desc">{description}</p>
				</header>
				<PostToc {headings} />
				<div class="prose">
					<slot />
				</div>
			</article>

			{
				series && seriesPosts && seriesPosts.length > 1 && (
					<SeriesToc name={series} posts={seriesPosts} currentId={id} />
				)
			}

			{
				(prev || next) && (
					<nav class="series-nav" aria-label="연재 내비게이션">
						{prev ? (
							<a class="nav-item prev" href={href(prev)} rel="prev">
								<span class="dir">← 이전 편</span>
								<span class="t">{prev.data.title}</span>
							</a>
						) : (
							<span class="nav-item empty" />
						)}
						{next ? (
							<a class="nav-item next" href={href(next)} rel="next">
								<span class="dir">다음 편 →</span>
								<span class="t">{next.data.title}</span>
							</a>
						) : (
							<span class="nav-item empty" />
						)}
					</nav>
				)
			}

			<p class="back">
				<a href={`/${category}`}>← {CATEGORIES[category].heading} 전체 보기</a>
			</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	article {
		padding-top: 1rem;
	}
	.hero-image img {
		display: block;
		margin: 0 auto 2rem;
		border-radius: 12px;
		box-shadow: var(--box-shadow);
	}
	.title {
		padding-bottom: 1.4rem;
		margin-bottom: 2rem;
		border-bottom: 1px solid var(--border);
	}
	/* The series name sits above the title, the way a serial is labelled. */
	.series {
		color: var(--muted);
		font-size: 0.92rem;
		margin: 0 0 0.4rem;
	}
	.title h1 {
		margin: 0;
		font-size: 1.9rem;
		line-height: 1.35;
	}
	.desc {
		color: var(--muted);
		margin: 0.9rem 0 0;
		font-size: 0.95rem;
	}
	.meta {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--muted);
		margin: 0 0 0.7rem;
	}
	.meta .cat {
		color: var(--green);
	}
	.meta .sep {
		margin: 0 0.45rem;
		color: var(--border-strong);
	}
	.meta .updated {
		font-style: italic;
	}
	.prose {
		color: var(--fg);
	}

	/* Follows the table of contents, which already separates it from the article. */
	.series-nav {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin-top: 1rem;
	}
	.nav-item {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 0.9rem 1rem;
		border: 1px solid var(--border);
		border-radius: 8px;
		text-decoration: none;
		min-width: 0;
	}
	a.nav-item:hover {
		border-color: var(--border-strong);
		background: var(--surface);
		text-decoration: none;
	}
	.nav-item.empty {
		border: none;
	}
	.nav-item .dir {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--muted);
	}
	.nav-item .t {
		color: var(--fg-strong);
		font-size: 0.92rem;
		line-height: 1.45;
	}
	a.nav-item:hover .t {
		color: var(--accent);
	}
	.next {
		text-align: right;
	}

	.back {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		margin: 1.5rem 0 0;
	}

	@media (max-width: 640px) {
		.title h1 {
			font-size: 1.6rem;
		}
		.series-nav {
			grid-template-columns: 1fr;
		}
		.nav-item.empty {
			display: none;
		}
		.next {
			text-align: left;
		}
	}
</style>
