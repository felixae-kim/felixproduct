---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="brand" href="/">
			<span class="prompt">~</span> seongjae.kim
		</a>
		<div class="links">
			<HeaderLink href="/">home</HeaderLink>
			<HeaderLink href="/blog">writing</HeaderLink>
			<HeaderLink href="/about">about</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: rgba(13, 17, 23, 0.8);
		backdrop-filter: saturate(1.4) blur(8px);
		border-bottom: 1px solid var(--border);
	}
	nav {
		max-width: 720px;
		margin: 0 auto;
		padding: 0 1em;
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-family: var(--font-mono);
		height: 52px;
	}
	.brand {
		color: var(--fg-strong);
		text-decoration: none;
		font-size: 0.95rem;
		white-space: nowrap;
	}
	.brand:hover {
		text-decoration: none;
	}
	.prompt {
		color: var(--green);
	}
	.links {
		display: flex;
		gap: 0.3em;
	}
	.links :global(a) {
		color: var(--muted);
		text-decoration: none;
		font-size: 0.9rem;
		padding: 0.3em 0.6em;
		border-radius: 6px;
	}
	.links :global(a:hover) {
		color: var(--fg-strong);
		background: var(--surface);
		text-decoration: none;
	}
	.links :global(a.active) {
		color: var(--green);
	}
	@media (max-width: 520px) {
		.links :global(a) {
			padding: 0.3em 0.4em;
			font-size: 0.85rem;
		}
	}
</style>
