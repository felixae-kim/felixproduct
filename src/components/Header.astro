---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="brand" href="/">{SITE_TITLE}</a>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Writing</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="social-links">
			<!-- TODO: replace with your LinkedIn / GitHub -->
			<a href="https://www.linkedin.com/" target="_blank" rel="me" aria-label="LinkedIn">
				<svg viewBox="0 0 16 16" aria-hidden="true" width="22" height="22"
					><path
						fill="currentColor"
						d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169H6.25c.03.678 0 7.225 0 7.225h2.401z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		margin: 0;
		padding: 0 1.2em;
		background: rgba(var(--surface), 0.85);
		backdrop-filter: saturate(1.4) blur(8px);
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	nav {
		max-width: 760px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
	}
	.brand {
		font-weight: 700;
		letter-spacing: -0.02em;
		color: rgb(var(--black));
		text-decoration: none;
		white-space: nowrap;
	}
	.internal-links {
		display: flex;
		gap: 0.2em;
		margin-left: auto;
	}
	nav a {
		padding: 1em 0.7em;
		color: rgb(var(--gray-dark));
		border-bottom: 2px solid transparent;
		text-decoration: none;
		font-size: 0.95rem;
	}
	nav a.active {
		color: rgb(var(--black));
		border-bottom-color: var(--accent);
	}
	.social-links {
		display: flex;
		align-items: center;
	}
	.social-links a {
		color: rgb(var(--gray));
		padding: 0.4em;
	}
	.social-links a:hover {
		color: var(--accent);
	}
	@media (max-width: 520px) {
		header {
			padding: 0 1em;
		}
		.brand {
			font-size: 0.95rem;
		}
		nav a {
			padding: 0.9em 0.5em;
			font-size: 0.9rem;
		}
		.social-links {
			display: none;
		}
	}
</style>
