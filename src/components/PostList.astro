---
import FormattedDate from './FormattedDate.astro';
import { href, type Post, seriesNo } from '../lib/posts';

interface Props {
	posts: Post[];
	/** Renders an <ol> for a full series index, a <ul> for excerpt lists. */
	ordered?: boolean;
}

const { posts, ordered = false } = Astro.props;
const Tag = ordered ? 'ol' : 'ul';
---

<Tag class="posts">
	{
		posts.map((post) => (
			<li>
				<a href={href(post)}>
					<span class="no">{seriesNo(post) ? `[${seriesNo(post)}]` : '·'}</span>
					<span class="body">
						<span class="t">{post.data.title}</span>
						<span class="d">{post.data.description}</span>
					</span>
					<span class="date">
						<FormattedDate date={post.data.pubDate} />
					</span>
				</a>
			</li>
		))
	}
</Tag>

<style>
	.posts {
		list-style: none;
		padding: 0;
		margin: 0;
		border-top: 1px solid var(--border);
	}
	.posts li {
		margin: 0;
		border-bottom: 1px solid var(--border);
	}
	.posts a {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: baseline;
		gap: 0.2rem 0.9rem;
		padding: 1.1rem 0.2rem;
		text-decoration: none;
	}
	.posts a:hover {
		text-decoration: none;
	}
	.no {
		font-family: var(--font-mono);
		color: var(--green);
		font-size: 0.9rem;
	}
	.body {
		min-width: 0;
	}
	.t {
		display: block;
		font-family: var(--font-mono);
		color: var(--fg-strong);
		font-size: 1rem;
		line-height: 1.45;
	}
	.d {
		display: block;
		color: var(--muted);
		font-size: 0.9rem;
		line-height: 1.6;
		margin-top: 0.3rem;
	}
	.posts a:hover .t {
		color: var(--accent);
	}
	.posts a:hover .d {
		color: var(--fg);
	}
	.date {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--muted);
		white-space: nowrap;
	}

	@media (max-width: 640px) {
		.posts a {
			grid-template-columns: auto 1fr;
			gap: 0.3rem 0.7rem;
		}
		.date {
			grid-column: 2;
			grid-row: 1;
			justify-self: end;
		}
		.body {
			grid-column: 2;
			grid-row: 2;
		}
	}
</style>
