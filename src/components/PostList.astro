---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
	/** Renders an <ol> for the full series index, a <ul> for excerpt lists. */
	ordered?: boolean;
}

const { posts, ordered = false } = Astro.props;
const Tag = ordered ? 'ol' : 'ul';
---

<Tag class="posts">
	{
		posts.map((post) => (
			<li>
				<a href={`/blog/${post.id}/`}>
					<span class="no">[{post.id.slice(0, 2)}]</span>
					<span class="t">{post.data.title}</span>
					<span class="date">
						<FormattedDate date={post.data.pubDate} />
					</span>
				</a>
			</li>
		))
	}
</Tag>

<style>
	.posts {
		list-style: none;
		padding: 0;
		margin: 0;
		font-family: var(--font-mono);
		border-top: 1px solid var(--border);
	}
	.posts li {
		margin: 0;
		border-bottom: 1px solid var(--border);
	}
	.posts a {
		display: flex;
		align-items: baseline;
		gap: 0.9rem;
		padding: 0.75rem 0.2rem;
		text-decoration: none;
	}
	.posts a:hover {
		text-decoration: none;
	}
	.posts .no {
		flex: 0 0 auto;
		color: var(--green);
		font-size: 0.9rem;
	}
	.posts .t {
		flex: 1 1 auto;
		color: var(--fg-strong);
		font-size: 0.95rem;
	}
	.posts a:hover .t {
		color: var(--accent);
	}
	.posts .date {
		flex: 0 0 auto;
		font-size: 0.78rem;
		color: var(--muted);
		white-space: nowrap;
	}

	@media (max-width: 640px) {
		.posts a {
			flex-wrap: wrap;
			gap: 0.3rem 0.6rem;
		}
		.posts .t {
			flex: 1 1 100%;
			order: 3;
			padding-left: 2.1rem;
		}
		.posts .no {
			order: 1;
		}
		.posts .date {
			order: 2;
			margin-left: auto;
		}
	}
</style>
