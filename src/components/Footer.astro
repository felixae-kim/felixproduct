---
import { AUTHOR_NAME } from '../consts';
const today = new Date();
---

<footer>
	<span class="left">&copy; {today.getFullYear()} {AUTHOR_NAME}</span>
	<span class="right">built with astro</span>
</footer>
<style>
	footer {
		max-width: 720px;
		margin: 0 auto;
		padding: 2em 1em 3em;
		border-top: 1px solid var(--border);
		display: flex;
		justify-content: space-between;
		gap: 1em;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--muted);
	}
	@media (max-width: 520px) {
		footer {
			flex-direction: column;
			gap: 0.4em;
		}
	}
</style>
